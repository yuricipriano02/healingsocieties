@article{CehajicBrownGonzalez2009WhatDoICare,
  author  = {Čehajić, Sabina and Brown, Rupert and González, Roberto},
  title   = {What Do I Care? Perception of Ingroup Responsibility and Dehumanization as Predictors of Empathy Felt for the Victim Group},
  journal = {Group Processes \& Intergroup Relations},
  year    = {2009},
  volume  = {12},
  number  = {6},
  pages   = {715--729},
file = {care.pdf},
selected = {true},
abstract = {This research examined the effects of reminders of ingroup responsibility for past wrongdoings on perception of ingroup responsibility and victim dehumanization as predictors of empathy. Two experiments set in different intergroup contexts found that reminders of ingroup responsibility generated empathy through perception of ingroup responsibility and deflected empathy through subtle victim dehumanization. In Experiment 1, set in the context of indigenous–non-indigenous relations in Chile (N = 124), it was found that reminders of ingroup (vs. individual) responsibility generated empathy by increasing a perception of ingroup responsibility and deflected it through decreased attribution of secondary emotions to the victim group. Experiment 2 replicated the effects in a different context, the recent 1992–1995 war in Bosnia (N = 158). Reminders of ingroup responsibility (vs. no reminders) generated empathy by increasing a perception of ingroup responsibility and deflected it through decreased attribution of secondary emotions to the victim group. Theoretical and practical implications are discussed.}
}

